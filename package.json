{
    "name": "tech-stack-detector",
    "version": "0.0.1",
    "type": "module",
    "description": "Detect the technology stack behind any website: CMS, frameworks, analytics, ecommerce, CDN, hosting and 7,000+ more.",
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "@crawlee/cheerio": "^3.15.3",
        "apify": "^3.7.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "cheerio": "^1.2.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.0"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "fingerprints:update": "node scripts/update-fingerprints.mjs"
    },
    "author": "Josh Smith",
    "license": "GPL-3.0"
}
